{
	"extends": "./tsconfig.base.json",
	// vendetta-types' package.json points "types" at def.d.ts (missing an "s"),
	// so the type library can't be loaded via compilerOptions.types; include
	// its ambient defs.d.ts explicitly instead.
	"files": ["node_modules/vendetta-types/defs.d.ts"],
	"include": ["plugins"],
	"exclude": ["plugins/AddAlts", "dist"]
}
